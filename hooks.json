{
  "architecture-approval-guard": {
    "enabled": true,
    "PreToolUse": [{
      "matcher": "run_command|file_change|.*(edit|write|create|delete|move|rename|patch|apply|replace|insert).*|mcp:.*",
      "hooks": [{
        "type": "command",
        "command": "node ./scripts/approval-gate.mjs",
        "timeout": 5
      }]
    }]
  }
}